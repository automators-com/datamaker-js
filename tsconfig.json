{
  "compilerOptions": {
    /* The SDK ships ESM and CJS and must work on Node 18+, Deno, Bun,
       browsers and edge runtimes, so it targets modern JS and resolves like a
       bundler. `.js` specifiers in source are deliberate: they are what ESM
       requires at runtime, and tsup rewrites them for the CJS build. */
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    /* Indexing an array can yield undefined, and the SDK hands array results
       straight to callers, so the types should say so. */
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "noEmit": true,
    /* The generated schema is 8k lines of machine output: checking it adds
       seconds to every run and could never be acted on by hand anyway. */
    "skipLibCheck": true
  },
  "include": ["src", "scripts"],
  "exclude": ["dist", "node_modules"]
}
